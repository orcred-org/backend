# ── LOCAL SUPABASE (copy to .env.local — or run `npm run db:env` to auto-fill) ──
# Docker + `npm run db:start` must be running first.
# These keys are NOT your production project — safe to reset anytime.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep using local API + app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
ADMIN_IP_ALLOWLIST=

# Optional — copy from your old .env if you need real emails/AI in local dev
RESEND_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
DAILY_API_KEY=
ANTHROPIC_API_KEY=
CREDENTIAL_HASH_SECRET=local-dev-credential-hash-secret
CRON_SECRET=local-dev-cron
