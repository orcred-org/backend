# Supabase — use DEV project locally; PROD only on Vercel production (see ../ENVIRONMENTS.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
# Optional — defaults to Orcred <noreply@orcred.com> (domain must be verified in Resend)
RESEND_FROM=

# Admin notifications (waitlist signups, new applications, etc.)
ADMIN_NOTIFY_EMAIL=

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Daily.co
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=
# Set to true only on a Daily plan with cloud recording enabled
DAILY_ENABLE_RECORDING=

# Razorpay (test keys until KYC complete — manual admin payment works without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Credential signing
CREDENTIAL_HASH_SECRET=

# Admin — production only; leave empty in local dev (browser requests have no x-forwarded-for)
ADMIN_IP_ALLOWLIST=

# Cron
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Platform gates (defaults: admin-only login, student apply off)
ADMIN_ONLY_AUTH=true
STUDENT_APPLY_ENABLED=false

# Vercel preview / testing frontend origin (comma-separated). *.vercel.app is also allowed.
# CORS_EXTRA_ORIGINS=https://your-frontend.vercel.app

# Enable OPTIONS Allowlist with path /api in Vercel → Deployment Protection (required
# when frontend sends x-vercel-protection-bypass on cross-origin API calls).
